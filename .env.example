# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.

# ---- LLM ----
# gemini (mặc định) | openai | fake (dùng cho test, không gọi mạng)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ngân sách an toàn: số lần gọi tool tối đa cho một yêu cầu (số nguyên >= 1)
AGENT_MAX_STEPS=8
# Giới hạn số lần gọi LLM mỗi phút ở phía ứng dụng (0 = không giới hạn). Gói miễn phí của
# Gemini cho khoảng 15 request/phút/model nên đặt 12 khi chạy `make eval`.
LLM_MAX_RPM=0
# Dùng LLM trích thông số khi luật regex không đủ (tốn lượt gọi; có cache)
LLM_EXTRACTOR_ENABLED=true

# ---- Cơ sở dữ liệu ----
# PostgreSQL chạy bằng Docker Compose (service `db`, `make db-up`). Docker Compose đọc các biến POSTGRES_*.
POSTGRES_USER=buyer
POSTGRES_PASSWORD=buyer_dev_password
POSTGRES_DB=product_buyer
# Cổng hợp lệ: 1-65535
POSTGRES_PORT=5432
# Dùng 127.0.0.1 thay vì localhost: Docker chỉ mở cổng trên IPv4, `localhost` thử ::1 trước và mỗi kết
# nối mới treo hết connect_timeout (3 giây) trên Windows. Đổi cổng cho khớp POSTGRES_PORT nếu đã đổi.
DATABASE_URL=postgresql+psycopg://buyer:buyer_dev_password@127.0.0.1:5432/product_buyer
# Database riêng cho pytest (tạo tự động khi container khởi tạo lần đầu); mỗi test rollback
TEST_DATABASE_URL=postgresql+psycopg://buyer:buyer_dev_password@127.0.0.1:5432/product_buyer_test
# Database riêng cho `make e2e` (Playwright). Bỏ trống hoặc xóa dòng này thì suy ra từ DATABASE_URL + `_e2e`.
# Tên DB BẮT BUỘC kết thúc `_e2e` (script từ chối nếu khác vì seed --reset xóa sạch mọi bảng); script tự tạo DB.
E2E_DATABASE_URL=postgresql+psycopg://buyer:buyer_dev_password@127.0.0.1:5432/product_buyer_e2e

# ---- Thu thập dữ liệu ----
# User-Agent trung thực, có thông tin liên hệ (bắt buộc, không được rỗng; khoảng trắng đầu/cuối bị bỏ)
SCRAPER_USER_AGENT=ProductBuyerAgent/0.1 (do-an-sinh-vien; lien-he: your-email@example.com)
# Độ trễ tối thiểu giữa 2 request cùng domain (giây, >= 0). Lấy max với Crawl-delay trong robots.txt và cấu hình từng trang.
SCRAPER_MIN_DELAY_SECONDS=5
# Timeout mỗi request (giây, > 0)
SCRAPER_TIMEOUT_SECONDS=30
# Số lần thử lại tối đa (>= 0)
SCRAPER_MAX_RETRIES=3
# Giới hạn số trang danh sách mỗi lượt thu thập (an toàn khi phát triển; số nguyên >= 1)
SCRAPER_MAX_LISTING_PAGES=3
# true = chỉ chạy mock-shop, không truy cập trang thật
SCRAPER_OFFLINE_ONLY=true

# ---- Mock-shop (trang giả lập phân trang + captcha) ----
# Chỉ nhận localhost, 127.0.0.1 hoặc ::1 (mock-shop được miễn robots/ngoại tuyến của trang thật)
MOCK_SHOP_URL=http://localhost:8100
# Sau bao nhiêu request liên tiếp thì mock-shop đòi captcha
MOCK_SHOP_CAPTCHA_AFTER=5
# Độ trễ giữa 2 request tới mock-shop (giây); test đặt 0. Không áp dụng cho trang thật.
MOCK_SHOP_DELAY_SECONDS=1

# ---- Lịch chạy ----
# Mặc định tắt: `make worker` thoát ngay. Bật (true) để worker chạy hai job theo cron bên dưới (UTC,
# crontab 5 trường). Ngoại tuyến (SCRAPER_OFFLINE_ONLY=true) thì chỉ mock-shop được thu thập.
SCHEDULER_ENABLED=false
CATALOG_REFRESH_CRON=0 */12 * * *
TRACKED_REFRESH_CRON=0 */6 * * *

# ---- Thông báo giá ----
# Email cần cả SMTP_HOST và ALERT_EMAIL_FROM; Telegram cần TELEGRAM_BOT_TOKEN (kênh thiếu cấu hình
# thì cảnh báo của kênh đó không được gửi). Cổng 465 dùng TLS ngay; các cổng khác (587, 25) dùng STARTTLS.
SMTP_HOST=
# Cổng hợp lệ: 1-65535
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
# Nơi nhận cảnh báo mặc định (agent không tự hỏi/lưu thông tin liên hệ)
ALERT_DEFAULT_CHANNEL=email
ALERT_DEFAULT_EMAIL=
TELEGRAM_CHAT_ID=

# ---- Frontend ----
# Vite đọc file .env ở thư mục gốc (vite.config.ts đặt envDir: '..'); chỉ biến có tiền tố VITE_ được đưa ra trình duyệt.
# Không gồm /api: client tự thêm tiền tố /api.
VITE_API_BASE_URL=http://localhost:8000

# ---- MCP cho Claude Code (tùy chọn) ----
# LƯU Ý: Claude Code đọc biến này từ môi trường shell, KHÔNG từ file .env.
# Hãy export trước khi chạy `claude`, ví dụ: export CONTEXT7_API_KEY=...  (giữ dòng dưới chỉ để ghi nhớ)
CONTEXT7_API_KEY=
